# Copy to .env for the live Databricks suite. .env is gitignored; this file is
# the template and must never contain a real token.
#
#   cp .env.example .env && $EDITOR .env
#   set -a && . ./.env && set +a
#   python -m tests.live_preflight

DELTASWAMP_TEST_DATABRICKS=1

DATABRICKS_HOST=https://adb-0000000000000000.0.azuredatabricks.net
DATABRICKS_TOKEN=dapiREPLACE_ME

# A catalog and schema the suite may create and drop tables in.
DELTASWAMP_TEST_CATALOG=main
DELTASWAMP_TEST_SCHEMA=deltaswamp_test

# Optional. A SQL warehouse unlocks most of the suite, because creating the
# fixture tables is not something this library does.
DELTASWAMP_TEST_WAREHOUSE_ID=

# Optional. An external location for external-table tests.
DELTASWAMP_TEST_EXTERNAL_LOCATION=
